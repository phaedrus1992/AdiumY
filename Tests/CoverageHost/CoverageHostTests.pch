/*
 * Prefix header for the CoverageHostTests target.
 *
 * The real Adium app compiles every TU against Adium.pch, which imports
 * <Cocoa/Cocoa.h> globally; real Adium headers (AIAdiumProtocol.h,
 * AIAbstractListObjectMenu.h, ...) rely on that and declare no imports of
 * their own. clang-format's SortIncludes orders <AdiumY/...> before
 * <Cocoa/Cocoa.h>, so plugin headers can no longer guarantee Foundation is in
 * scope before a pch-dependent header is parsed. Restore the app's invariant
 * here so the include chain is order-independent.
 */

#ifdef __OBJC__
	#import <Cocoa/Cocoa.h>
	// Adium.pch also imports ESDebugAILog.h globally, which defines the AILog macros. Plugin TUs that
	// use AILog/AILogWithSignature rely on it being in scope; restore that invariant here. The impl
	// symbols (AIDebugLoggingEnabled, AILog_impl, AILogWithPrefix_impl, AILogWithSignature_impl) are
	// supplied by the test bundle's link shims.
	#import <AdiumY/ESDebugAILog.h>
	// Adium.pch also imports AIStringUtilities.h (the AILocalizedString macro) and AILocalizationAssistance.h
	// (the NSButton/NSTextField/NSButtonCell setLocalizedString: categories) globally. XtrasInstaller.m uses
	// both with no local import, so restore those invariants too.
	#import <AIUtilities/AIStringUtilities.h>
	#import <AdiumY/AILocalizationAssistance.h>
#endif
