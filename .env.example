# Copy to .env (gitignored) and fill in. fastlane loads it automatically.
# See docs/releasing.md for where each value comes from.

# App Store Connect API key, for notarization. Both values appear at
# appstoreconnect.apple.com > Users and Access > Integrations once you create
# a Team key. Required.
ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="YYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY"

# Path to the downloaded .p8. Only needed if it is not at the default
# ~/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8
#ASC_KEY_PATH="/path/to/AuthKey_XXXXXXXXXX.p8"

# Apple team owning the Developer ID certificate. Defaults to C36L3X7U5T; set
# this only when signing as a different team.
#TEAM_ID="C36L3X7U5T"

# Full name of the signing identity, exactly as `security find-identity -v -p
# codesigning` prints it between the quotes. Normally discovered from TEAM_ID;
# set this only to disambiguate several Developer ID certificates on one team.
#DEVELOPER_ID_IDENTITY="Developer ID Application: Your Name (C36L3X7U5T)"
