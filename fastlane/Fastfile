# frozen_string_literal: true

# Release pipeline for AdiumY. See docs/releasing.md for credentials setup.
#
# Signing is applied to the finished bundle rather than baked into the Xcode
# project, so contributors without the Developer ID certificate can still
# build and PR builds stay unsigned. Hardened runtime and entitlements are
# codesign flags, applied by Release/sign-bundle.sh.

require "base64"
require "fileutils"
require "json"
require "open3"
require "shellwords"
require "tmpdir"

default_platform(:mac)

ROOT = File.expand_path("..", __dir__)

APP_NAME      = "AdiumY"
TEAM_ID       = ENV["TEAM_ID"].to_s.empty? ? "C36L3X7U5T" : ENV["TEAM_ID"]
CONFIGURATION = "Release"
ENTITLEMENTS  = File.join(ROOT, "Adium.entitlements")
BUILD_DIR     = File.join(ROOT, "build")
DIST_DIR      = File.join(BUILD_DIR, "dist")
SPARKLE_TOOLS = File.join(ROOT, "Dependencies", "build", "sparkle-tools")
APPCAST       = File.join(ROOT, "appcast.xml")
GITHUB_REPO   = "phaedrus1992/AdiumY"
DOWNLOAD_URL  = "https://github.com/#{GITHUB_REPO}/releases/download"

def app_path
  File.join(BUILD_DIR, CONFIGURATION, "#{APP_NAME}.app")
end

def dmg_path(version)
  File.join(DIST_DIR, "#{APP_NAME}-#{version}.dmg")
end

# Resolves the Developer ID Application identity for this team, so the
# certificate's common name never has to be hardcoded or passed by hand.
def signing_identity
  identities = sh("security find-identity -v -p codesigning", log: false)

  override = ENV["DEVELOPER_ID_IDENTITY"].to_s
  return resolve_identity_override(override, identities) unless override.empty?

  found = identities[/"(Developer ID Application:[^"]*\(#{TEAM_ID}\))"/, 1]
  return found if found

  # Listing what is actually installed turns "wrong team" — the most likely
  # cause — into a one-line diagnosis instead of a guess.
  available = identities.scan(/"(Developer ID Application:[^"]*)"/).flatten.uniq
  UI.user_error!(<<~ERROR)
    No "Developer ID Application" certificate for team #{TEAM_ID} in the keychain.

    #{available.empty? ? "No Developer ID certificates are installed at all." : "Installed Developer ID certificates:\n" + available.map { |i| "      #{i}" }.join("\n")}

    If one of those is the right certificate, its team differs from #{TEAM_ID}.
    Set TEAM_ID to the code in its parentheses, or DEVELOPER_ID_IDENTITY to the
    whole quoted name. Otherwise create a certificate in
    Xcode > Settings > Accounts. See docs/releasing.md.
  ERROR
end

# codesign -s matches substrings, so a bare team ID "works" while leaving
# sign-bundle.sh unable to parse a team out of it — which silently disables its
# wrong-team audit. Insist on the full name or the SHA-1.
def resolve_identity_override(override, identities)
  return override if identities.include?("\"#{override}\"")
  return override if identities.match?(/^\s*\d+\)\s+#{Regexp.escape(override)}\s/)

  UI.user_error!(<<~ERROR)
    DEVELOPER_ID_IDENTITY is set to "#{override}", which is not an installed
    signing identity.

    It must be the whole name between the quotes in `security find-identity -v
    -p codesigning`, for example:

      DEVELOPER_ID_IDENTITY="Developer ID Application: Your Name (#{TEAM_ID})"

    A bare team ID is not enough. To select by team instead, unset
    DEVELOPER_ID_IDENTITY and set TEAM_ID. See docs/releasing.md.
  ERROR
end

def asc_api_key
  key_id = ENV["ASC_KEY_ID"].to_s
  issuer = ENV["ASC_ISSUER_ID"].to_s
  UI.user_error!(<<~ERROR) if key_id.empty? || issuer.empty?
    ASC_KEY_ID and ASC_ISSUER_ID are not set.

    Both are shown at appstoreconnect.apple.com > Users and Access >
    Integrations > App Store Connect API, after you create a Team key:

      ASC_ISSUER_ID  the "Issuer ID" above the key list, a UUID. One per team.
      ASC_KEY_ID     the "KEY ID" column of your key, 10 characters.

    See docs/releasing.md.
  ERROR

  path = ENV["ASC_KEY_PATH"]
  path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8") if path.to_s.empty?
  UI.user_error!(<<~ERROR) unless File.exist?(path)
    App Store Connect API key not found at #{path}.

    The .p8 downloads once, from the same page as the IDs. Move it there, or
    point ASC_KEY_PATH at it. See docs/releasing.md.
  ERROR

  { id: key_id, issuer: issuer, path: path }
end

# Cheapest call that proves all three values are right and the key still has
# access. Catches a typo now rather than after an hour-long build.
def verify_asc_credentials
  key = asc_api_key
  sh("xcrun", "notarytool", "history", *notary_args(key), "--output-format", "json",
     log: false, error_callback: lambda { |_|
       UI.user_error!(<<~ERROR)
         App Store Connect rejected the API key.

         Check that ASC_KEY_ID (#{key[:id]}) matches the filename at
         #{key[:path]}, that ASC_ISSUER_ID is the Issuer ID UUID and not the
         key ID, and that the key is a Team key with at least the Developer
         role. Individual keys cannot notarize.
       ERROR
     })
end

# nil rather than an error, for callers that can proceed without a version.
# The "v" prefix is stripped from either source, so VERSION=v2.1.0 can't
# produce a "vv2.1.0" tag on publish or a non-numeric CFBundleVersion.
def resolved_version
  from_env = ENV["VERSION"].to_s
  return from_env.delete_prefix("v") unless from_env.empty?

  tag = sh("git -C #{ROOT.shellescape} describe --tags --exact-match 2>/dev/null || true", log: false).strip
  tag.empty? ? nil : tag.delete_prefix("v")
end

def release_version
  resolved_version ||
    UI.user_error!("HEAD is not on a version tag. Pass VERSION=x.y.z or tag the commit.")
end

# Sparkle refuses an archive whose CFBundleVersion is missing, and Xcode drops
# the key entirely when the build setting behind it expands to empty. Catch it
# at build time rather than at the appcast step, an hour later.
def assert_bundle_version(app)
  plist = File.join(app, "Contents", "Info.plist")
  version = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' #{plist.shellescape} 2>/dev/null || true",
               log: false).strip
  UI.user_error!(<<~ERROR) if version.empty?
    #{app} has no CFBundleVersion.

    Resources/Info.plist maps it to $(CURRENT_PROJECT_VERSION); check that
    xcconfigs/Base.xcconfig still defines it. Sparkle rejects archives without
    it, so the appcast lane would fail.
  ERROR
  version
end

def notary_args(key)
  ["--key", key[:path], "--key-id", key[:id], "--issuer", key[:issuer]]
end

# Apple's queue has no SLA. Observed over half an hour on a first submission,
# so the default is generous; NOTARY_TIMEOUT overrides it.
def notary_timeout
  from_env = ENV["NOTARY_TIMEOUT"].to_s
  from_env.empty? ? "2h" : from_env
end

# Every notarytool call that wants structured data goes through here, so
# "the command failed" and "the command succeeded with an unexpected verdict"
# can never collapse into the same silent {}. A `--wait` submission that hits
# NOTARY_TIMEOUT exits non-zero from notarytool itself but still prints a
# valid ticket with an id and a status — the exit code alone can't tell a
# live queue apart from a broken key or a dead network, so failure is judged
# by whether Apple sent back parseable JSON, not by the process exit status.
def notarytool_json(*args, key:)
  raw = sh("xcrun", "notarytool", *args, *notary_args(key), "--output-format", "json",
           log: false, error_callback: ->(_) {})
  parsed = begin
    JSON.parse(raw[/\{.*\}/m].to_s)
  rescue JSON::ParserError
    nil
  end

  UI.user_error!(<<~ERROR) if parsed.nil?
    xcrun notarytool #{args.join(' ')} produced no usable output:

    #{raw}
  ERROR

  parsed
end

# Same non-JSON shape, for `notarytool log`. Kept separate from
# notarytool_json rather than unified, because a failure here is reported
# inline in the caller's message rather than raised on its own.
def notarytool_text(*args, key:)
  failed = false
  output = sh("xcrun", "notarytool", *args, *notary_args(key), log: false,
              error_callback: ->(_) { failed = true })
  failed ? "(failed to fetch the log itself: #{output})" : output
end

def notarize_and_staple(path)
  key = asc_api_key
  submitted = path.end_with?(".app") ? zip_for_notarization(path) : path

  ticket = notarytool_json("submit", submitted, "--wait", "--timeout", notary_timeout, key: key)
  check_notarization_ticket(ticket, key, path) unless ticket["status"] == "Accepted"

  File.delete(submitted) if submitted != path && File.exist?(submitted)
  staple(path)
end

def staple(path)
  sh("xcrun", "stapler", "staple", path)
  sh("xcrun", "stapler", "validate", path)
end

# fastlane downcases lane option keys, so `SUBMISSION_ID:x` on the command line
# does not arrive as :SUBMISSION_ID. Accept any casing, and the env var.
def requested_submission_id(options)
  from_options = options.to_h.find { |k, _| k.to_s.casecmp?("submission_id") }&.last
  [from_options, ENV["SUBMISSION_ID"]].compact.map(&:to_s).find { |v| !v.empty? }.to_s
end

# Having to paste a UUID to finish a release is a pointless failure mode when
# the newest accepted submission is almost always the one meant.
def latest_accepted_submission(key)
  entries = notarytool_json("history", key: key)["history"] || []
  newest = entries.select { |e| e["status"] == "Accepted" }
                  .max_by { |e| e["createdDate"].to_s }
  UI.user_error!(<<~ERROR) unless newest
    No accepted notarization submission found.

    Check what you have with `bundle exec fastlane mac notary_status`, then pass
    one explicitly:

      bundle exec fastlane mac staple_notarized submission_id:<uuid>
  ERROR

  UI.message("Using latest accepted submission #{newest['id']} (#{newest['name']}, #{newest['createdDate']})")
  newest
end

# `submit` always zips the .app under a fixed name, and always submits the DMG
# itself (never zipped), so the submission's own "name" field is enough to
# tell staple_notarized which local file a resumed submission belongs to —
# without that, a DMG-side timeout gets "resolved" by stapling the app, which
# reports success while shipping a DMG with no ticket at all.
def artifact_for_submission(name)
  return app_path if name == "#{APP_NAME}.app.zip"

  dmg = File.join(DIST_DIR, name)
  UI.user_error!(<<~ERROR) unless File.exist?(dmg)
    Submission name #{name.inspect} matches neither #{File.basename(app_path)}.zip
    nor a file in #{DIST_DIR}. Was #{DIST_DIR} cleaned since that submission?
  ERROR
  dmg
end

# A queue timeout and a rejection both leave status != Accepted, but only one of
# them means the build is broken. Telling them apart avoids throwing away a
# submission that is still perfectly alive.
def check_notarization_ticket(ticket, key, path)
  id = ticket["id"].to_s
  status = ticket["status"]

  # notarytool always emits a submission id once Apple has accepted the
  # upload, even for a queue timeout. No id means the ticket we have is not a
  # real verdict at all — most likely `submit` never reached Apple.
  UI.user_error!(<<~ERROR) if id.empty?
    xcrun notarytool did not return a submission id for #{File.basename(path)}.

    Response: #{ticket.inspect}

    This is not a slow queue — it means the submit command itself did not
    reach Apple (bad credentials, no network, or a malformed upload).
  ERROR

  if status == "In Progress"
    UI.user_error!(<<~ERROR)
      Notarization of #{File.basename(path)} did not finish within #{notary_timeout}.
      Submission #{id} is still queued at Apple. Nothing is wrong with the build yet.

      Wait for it, then staple:

        bundle exec fastlane mac staple_notarized submission_id:#{id}

      Or raise the limit with NOTARY_TIMEOUT=4h.
    ERROR
  end

  log = notarytool_text("log", id, key: key)
  UI.user_error!("Notarization of #{File.basename(path)} was #{status}:\n#{log}")
end

# A .zip cannot be stapled, so it is only ever a transport for submission.
# ditto --keepParent preserves symlinks and the code signature.
def zip_for_notarization(app)
  zip = "#{app}.zip"
  File.delete(zip) if File.exist?(zip)
  sh("ditto", "-c", "-k", "--keepParent", app, zip)
  zip
end

# The Sparkle feed is served from main, so the appcast has to land there as
# well as on the release — but `release` runs from a detached tag checkout,
# never from main itself, and a build that takes an hour easily outlives
# whatever main's tip was at checkout time. Committing straight to ROOT's
# working tree would commit onto the tag and then fail to push to main at
# all; a disposable worktree lets the tag checkout stay untouched while still
# rebasing and retrying if main moved again between fetch and push.
#
# On CI the token is passed in the remote URL rather than persisted into
# .git/config by the checkout step.
def commit_appcast(version)
  token = ENV["GITHUB_TOKEN"].to_s
  push_target = token.empty? ? "origin" : "https://x-access-token:#{token}@github.com/#{GITHUB_REPO}.git"

  # Git names the worktree's internal .git/worktrees/<name> administrative
  # entry from the leaf of this path, not the full path — a literal "main"
  # leaf would let a second release collide with a first run's admin entry if
  # cleanup ever left one behind. mktmpdir's own leaf is already unique, so
  # the worktree lives directly at its path rather than a subdirectory of it.
  worktree = Dir.mktmpdir
  begin
    sh("git", "-C", ROOT, "fetch", "origin", "main", log: false)
    sh("git", "-C", ROOT, "worktree", "add", "--detach", worktree, "origin/main", log: false)

    FileUtils.cp(APPCAST, File.join(worktree, "appcast.xml"))
    sh("git", "-C", worktree, "add", "appcast.xml")
    sh("git", "-C", worktree, "commit", "-m", "chore(release): update appcast for #{version}")

    pushed = false
    3.times do
      rejected = false
      sh("git", "-C", worktree, "push", push_target, "HEAD:main",
         log: token.empty?, error_callback: ->(_) { rejected = true })
      unless rejected
        pushed = true
        break
      end
      sh("git", "-C", worktree, "fetch", "origin", "main", log: false)
      sh("git", "-C", worktree, "rebase", "origin/main", log: false)
    end
    UI.user_error!("Could not push appcast.xml to main: main kept moving after 3 attempts.") unless pushed
  ensure
    sh("git", "-C", ROOT, "worktree", "remove", "--force", worktree, log: false) if File.exist?(worktree)
  end
end

# generate_appcast reads the EdDSA key from the login keychain by default, and
# from stdin with `--ed-key-file -`. Piping the CI secret keeps the private key
# off the runner's disk entirely.
def run_generate_appcast(args)
  key = ENV["SPARKLE_PRIVATE_KEY"].to_s

  if key.empty?
    output, status = Open3.capture2e(*args)
  else
    output, status = Open3.capture2e(*args, "--ed-key-file", "-", stdin_data: key)
  end

  UI.user_error!(<<~ERROR) unless status.success?
    generate_appcast failed:

    #{output}

    With no SPARKLE_PRIVATE_KEY set it signs using the "Private key for signing
    Sparkle updates" item in your login keychain. Export it for CI with
    Dependencies/build/sparkle-tools/generate_keys -x <file>.
  ERROR
end

platform :mac do
  desc "Build the universal Release app. Unsigned beyond the ad-hoc link signature."
  lane :build do
    UI.message("Building vendored universal dependencies")
    sh("bash", File.join(ROOT, "Dependencies", "build-universal-deps.sh"))

    # Supplies both Sparkle.framework, which the app links against, and the
    # CLI tools the appcast lane needs.
    UI.message("Fetching Sparkle")
    sh("bash", File.join(ROOT, "Dependencies", "build-phases", "get-sparkle.sh"))

    UI.message("Building MMTabBarView.framework")
    sh("xcodebuild",
       "-project", File.join(ROOT, "Dependencies/MMTabBarView/MMTabBarView/MMTabBarView.xcodeproj"),
       "-scheme", "MMTabBarView", "-configuration", "Release", "-sdk", "macosx",
       "SYMROOT=#{BUILD_DIR}", "CODE_SIGNING_ALLOWED=NO", "build")
    sh("rm", "-rf", File.join(ROOT, "Frameworks/MMTabBarView.framework"))
    sh("cp", "-R", File.join(BUILD_DIR, "Release/MMTabBarView.framework"),
       File.join(ROOT, "Frameworks/MMTabBarView.framework"))

    # Stamp the version when there is one, so CFBundleVersion tracks the tag.
    # Without it the xcconfig floor applies, which is fine for a dev build but
    # would make every release look like the same version to Sparkle.
    version = resolved_version
    version_args = version ? ["CURRENT_PROJECT_VERSION=#{version}", "MARKETING_VERSION=#{version}"] : []

    UI.message("Building #{APP_NAME}.app#{version ? " #{version}" : ''}")
    sh("xcodebuild", "-project", File.join(ROOT, "Adium.xcodeproj"),
       "-target", APP_NAME, "-configuration", CONFIGURATION, "-sdk", "macosx",
       "SYMROOT=#{BUILD_DIR}", *version_args, "build")

    UI.success("Built #{app_path} (CFBundleVersion #{assert_bundle_version(app_path)})")
  end

  desc "Check every credential and setting a release needs, before spending an hour building."
  lane :preflight do
    signing_identity
    verify_asc_credentials

    key = sh("/usr/libexec/PlistBuddy -c 'Print :SUPublicEDKey' #{File.join(ROOT, 'Resources/Info.plist').shellescape}",
             log: false).strip
    UI.user_error!(<<~ERROR) if key.empty?
      SUPublicEDKey is empty in Resources/Info.plist. Sparkle cannot verify updates
      without it, and it cannot be changed after the first release ships.
      Run Dependencies/build/sparkle-tools/generate_keys and paste the public key in.
    ERROR

    # Deliberately not release_version: preflight is for checking credentials
    # at any time, so an untagged working branch must not fail it.
    UI.success("Preflight passed. Signing as: #{signing_identity}")
  end

  desc "Sign the built app inside-out with the Developer ID identity."
  lane :sign do
    UI.user_error!("#{app_path} not found. Run `fastlane build` first.") unless Dir.exist?(app_path)
    sh("bash", File.join(ROOT, "Release", "sign-bundle.sh"), app_path, signing_identity, ENTITLEMENTS)
  end

  desc "Notarize and staple the signed app, then confirm Gatekeeper accepts it."
  lane :notarize_app do
    notarize_and_staple(app_path)
    sh("spctl", "--assess", "--type", "execute", "--verbose=2", app_path)
    UI.success("Notarized and stapled #{app_path}")
  end

  desc "List your notarization submissions and their status. There is no web UI for these."
  lane :notary_status do
    puts sh("xcrun", "notarytool", "history", *notary_args(asc_api_key), log: false)
  end

  desc "Staple a submission that finished after the notarize lane gave up waiting."
  lane :staple_notarized do |options|
    key = asc_api_key
    id = requested_submission_id(options)
    entry = id.empty? ? latest_accepted_submission(key) : notarytool_json("info", id, key: key)

    # An unknown or wrong-team id still returns id + parseable JSON, just with
    # no "status" — only a "message" explaining why. Report that verbatim
    # rather than the uninformative "Submission X is , not Accepted."
    UI.user_error!("Submission #{id}: #{entry['message']}") if entry["message"] && !entry["status"]
    UI.user_error!("Submission #{entry['id']} is #{entry['status']}, not Accepted.") unless entry["status"] == "Accepted"

    artifact = artifact_for_submission(entry["name"])
    staple(artifact)
    sh("spctl", "--assess", "--type", "execute", "--verbose=2", artifact)
    UI.success("Stapled #{artifact} with submission #{entry['id']}")
  end

  desc "Build the disk image, then sign, notarize and staple it."
  lane :package do
    version = release_version
    dmg = dmg_path(version)
    sh("bash", File.join(ROOT, "Release", "make-dmg.sh"), app_path, version, dmg)
    sh("codesign", "--force", "--timestamp", "--sign", signing_identity, dmg)
    notarize_and_staple(dmg)
    UI.success("Packaged #{dmg}")
  end

  desc "Regenerate appcast.xml with an EdDSA signature for the current DMG."
  lane :appcast do
    version = release_version
    generate = File.join(SPARKLE_TOOLS, "generate_appcast")
    UI.user_error!("#{generate} missing. Run Dependencies/build-phases/get-sparkle.sh.") unless File.executable?(generate)

    # generate_appcast only reuses and extends a prior appcast that already
    # lives IN the archives directory it's pointed at — "-o" only controls
    # where the result is copied, it is never read for history. DIST_DIR is
    # recreated fresh by `package` and holds only the current version's DMG,
    # so without this, every release replaced the whole feed with a
    # single-item one for just the new version instead of adding to it.
    dist_appcast = File.join(DIST_DIR, "appcast.xml")
    FileUtils.cp(APPCAST, dist_appcast) if File.exist?(APPCAST)

    run_generate_appcast([generate, "--download-url-prefix", "#{DOWNLOAD_URL}/v#{version}/", DIST_DIR])

    UI.user_error!("generate_appcast did not produce #{dist_appcast}") unless File.exist?(dist_appcast)
    FileUtils.cp(dist_appcast, APPCAST)
    UI.success("Wrote #{APPCAST}")
  end

  desc "Create the GitHub Release and commit the updated appcast."
  lane :publish do
    version = release_version
    dmg = dmg_path(version)
    UI.user_error!("#{dmg} not found. Run `fastlane package` first.") unless File.exist?(dmg)

    sh("gh", "release", "create", "v#{version}", dmg, APPCAST,
       "--repo", GITHUB_REPO, "--title", "AdiumY #{version}", "--generate-notes")
    commit_appcast(version)
    UI.success("Published AdiumY #{version}")
  end

  desc "Full release: build, sign, notarize, package, appcast, publish."
  lane :release do
    version = release_version
    preflight
    UI.important("Releasing AdiumY #{version}")
    build
    sign
    notarize_app
    package
    appcast
    publish
  end

  desc "CI only: import the Developer ID certificate into a temporary keychain."
  lane :setup_signing do
    setup_ci(provider: "travis")
    p12 = File.join(Dir.mktmpdir, "developer_id.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("DEVELOPER_ID_P12")))
    import_certificate(
      certificate_path: p12,
      certificate_password: ENV.fetch("DEVELOPER_ID_P12_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
    File.delete(p12)
  end
end
