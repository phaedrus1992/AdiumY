# clangd configuration for AdiumY.
#
# clangd resolves the SDK, AdiumY/AIUtilities framework headers, and -fobjc-arc
# from the compilation database at the repo root (compile_commands.json). That
# database is regenerated by the same script that regenerates the
# CoverageHost.xcodeproj:
#
#   python3 Tests/CoverageHost/generate-xcodeproj.py
#   (or: make xcodeproj)
#
# Re-run it after adding sources or changing build settings so the LSP stays in
# sync with the real build.
CompileFlags:
  # Point at the repo-root database explicitly instead of relying on clangd's
  # ancestor search, so a stray database in a subdirectory cannot shadow it.
  CompilationDatabase: .
